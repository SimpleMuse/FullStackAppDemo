@page "/fetchproducts"
@inject HttpClient Http
@using System.Text.Json

<h3>Product List</h3>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Product</th>
            <th scope="col">Price</th>
            <th scope="col">Stock total</th>
            <th scope="col">Category</th>
        </tr>
    </thead>
    <tbody>
    @if (errorMessage != null)
    {
        <tr><td colspan="4" role="alert">@errorMessage</td></tr>
    }
    else if (products != null)
    {
        @foreach (var product in products)
        {
            <tr>
                <td>@product.Name</td>
                <td>$@product.Price</td>
                <td>@product.Stock</td>
                <td>@product.Category.Name</td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="4">Loading...</td></tr>
    }
    </tbody>
</table>

@code {
    private const int RequestTimeoutSeconds = 10;
    private Product[]? products;
    private string? errorMessage;
    private string requestUrl = "/api/productlist";

    protected override async Task OnInitializedAsync()
    {
        using var timeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(RequestTimeoutSeconds));

        try
        {
            products = await Http.GetFromJsonAsync<Product[]>(requestUrl, timeoutCts.Token)
                ?? throw new JsonException("The products response was empty.");
        }
        catch (TaskCanceledException) when (timeoutCts.IsCancellationRequested)
        {
            errorMessage = "The products request timed out. Please try again.";
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    public class Product
    {
        public int Id { get; set; }
        public required string Name { get; set; }
        public double Price { get; set; }
        public int Stock { get; set; }
        public required ProductCategory Category { get; set; }
    }

    public class ProductCategory
    {
        public int Id { get; set; }
        public required string Name { get; set; }
    }
}